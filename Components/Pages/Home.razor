@page "/"
@inject ExpenseDatabase Database
@inject NavigationManager Navigation

<PageTitle>Expenses</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Expenses</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6">Total Spent: Rs. @totalAmount.ToString("N2")</MudText>
    </MudPaper>

    <MudTextField @bind-Value="searchText"
                  Label="Search by title, category, amount or date"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mb-4" />

    <MudTable Items="@expenses" Hover="true" Filter="new Func<Expense, bool>(FilterExpense)">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Amount</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Date</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Title</MudTd>
            <MudTd>Rs. @context.Amount.ToString("N2")</MudTd>
            <MudTd>@context.Category</MudTd>
            <MudTd>@context.Date.ToString("dd MMM yyyy")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => EditExpense(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteExpense(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No expenses found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private List<Expense> expenses = new();
    private string searchText = string.Empty;
    private double totalAmount => expenses.Sum(e => e.Amount);

    protected override async Task OnInitializedAsync()
    {
        expenses = await Database.GetExpensesAsync();
    }

    private bool FilterExpense(Expense e)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        return e.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || e.Category.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || e.Amount.ToString().Contains(searchText)
            || e.Date.ToString("dd MMM yyyy").Contains(searchText, StringComparison.OrdinalIgnoreCase);
    }

    private void EditExpense(Expense expense)
    {
        Navigation.NavigateTo($"/edit/{expense.Id}");
    }

    private async Task DeleteExpense(Expense expense)
    {
        await Database.DeleteExpenseAsync(expense);
        expenses = await Database.GetExpensesAsync();
    }
}
